# GEMINI_API_KEY: Required for Gemini AI test planning and failure analysis.
# Configured automatically in AI Studio via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# AI_PROVIDER: Active LLM provider (gemini | openai_compatible)
AI_PROVIDER="gemini"

# AI_MODEL: Model identifier for test planning and failure analysis
AI_MODEL="gemini-4-hydrogen"

# Optional OpenAI-compatible provider settings (only used if AI_PROVIDER="openai_compatible")
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Browser automation configuration
PLAYWRIGHT_EXECUTABLE_PATH=""
MAX_EXECUTION_TIMEOUT_MS="90000"
STEP_TIMEOUT_MS="8000"

# Security controls
# Localhost/private IPs are blocked by default unless explicitly allowlisted or using the built-in sandbox app.
ALLOW_LOCALHOST_TESTING="false"
ALLOWED_TARGET_DOMAINS=""

# SQLite storage path
SQLITE_DB_PATH="data/sentinelqa.db"
SCREENSHOTS_DIR="data/screenshots"
